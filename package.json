{
  "name": "@brillliand/vue-table-chad",
  "version": "0.5.1",
  "description": "Composable headless table primitives for Vue 3",
  "keywords": [
    "vue",
    "vue3",
    "table",
    "datatable",
    "data-grid",
    "headless",
    "composable",
    "sorting",
    "filtering",
    "pagination",
    "grouping",
    "typescript"
  ],
  "license": "MIT",
  "author": "Bronnikov Aleksandr <brullik7@gmail.com>",
  "homepage": "https://brillliand.github.io/vue-table-chad/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrilllianD/vue-table-chad.git"
  },
  "bugs": {
    "url": "https://github.com/BrilllianD/vue-table-chad/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/vue-table-chad.js",
  "types": "./dist/vue-table-chad.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vue-table-chad.d.ts",
      "import": "./dist/vue-table-chad.js",
      "default": "./dist/vue-table-chad.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js",
      "default": "./dist/locales.js"
    },
    "./style.css": "./dist/vue-table-chad.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build && node scripts/copy-themes.ts",
    "build:playground": "vite build --config vite.playground.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:docs": "pnpm build:demo && node demo/inline.mjs",
    "build:site": "node scripts/build-site.ts",
    "docs:api": "node scripts/generate-api-reference.ts",
    "docs:index": "node scripts/generate-docs-index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "size": "node scripts/check-bundle-size.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.0.0",
    "shiki": "2.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.9"
  },
  "packageManager": "pnpm@11.3.0"
}
