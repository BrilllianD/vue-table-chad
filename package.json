{
  "name": "@sandbox/vue-table",
  "version": "0.1.0",
  "type": "module",
  "description": "Composable headless table primitives for Vue 3",
  "files": ["dist"],
  "main": "./dist/vue-table.js",
  "module": "./dist/vue-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-table.js"
    },
    "./style.css": "./dist/vue-table.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "build:playground": "vite build --config vite.playground.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "^20.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  },
  "packageManager": "pnpm@11.3.0"
}
