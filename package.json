{
  "name": "@brillliand/vue-table-chad",
  "version": "0.1.0",
  "description": "Composable headless table primitives for Vue 3",
  "keywords": [
    "vue",
    "vue3",
    "table",
    "datatable",
    "data-grid",
    "headless",
    "composable",
    "sorting",
    "filtering",
    "pagination",
    "grouping",
    "typescript"
  ],
  "license": "MIT",
  "author": "Bronnikov Aleksandr <brullik7@gmail.com>",
  "homepage": "https://bitbucket.org/BrilllianD/vue-table-chad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/BrilllianD/vue-table-chad.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/BrilllianD/vue-table-chad/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-table.js",
  "module": "./dist/vue-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-table.js"
    },
    "./style.css": "./dist/vue-table.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "build:playground": "vite build --config vite.playground.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:docs": "pnpm build:demo && node demo/inline.mjs",
    "docs:api": "node scripts/generate-api-reference.ts",
    "size": "node scripts/check-bundle-size.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.9"
  },
  "packageManager": "pnpm@11.3.0"
}
